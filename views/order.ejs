<%- include('partials/head') %>

<section class="order-head reveal">
  <span class="success-check" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.6"><path d="m5 12.5 5 5L20 6"/></svg>
  </span>
  <div>
    <span class="eyebrow">Pesanan dibuat</span>
    <h1>Terima kasih, <%= order.customer_name.split(' ')[0] %>.</h1>
    <p class="section-sub">Kode pesanan <strong><%= order.order_code %></strong> — simpan kode ini untuk konfirmasi ke admin.</p>
  </div>
  <span class="status-badge status-<%= statusMeta.tone %>"><%= statusMeta.label %></span>
</section>

<div class="checkout-grid">
  <div class="checkout-main">
    <section class="card card-pad">
      <div class="panel-head">
        <h2>Instruksi pembayaran</h2>
        <span class="pill"><%= paymentLabel(order.payment_method) %></span>
      </div>

      <% if (order.payment_method === 'cod') { %>
        <div class="instruction cod">
          <h3>Bayar tunai saat barang diterima</h3>
          <p>Siapkan uang tunai sebesar <strong><%= f.formatRupiah(order.total) %></strong> (termasuk biaya COD <%= f.formatRupiah(order.cod_fee) %>). Kurir akan menghubungi nomor <%= order.customer_phone %> sebelum tiba.</p>
          <ul class="instruction-list">
            <li>Periksa kondisi barang sebelum membayar.</li>
            <li>Pesanan berstatus “Diproses” dan langsung diteruskan ke seller.</li>
          </ul>
        </div>
      <% } else if (order.payment_channel === 'qris') { %>
        <div class="instruction qris">
          <h3>Pembayaran QRIS</h3>
          <p>Nominal yang harus dibayar: <strong><%= f.formatRupiah(order.total) %></strong>. Scan QRIS melalui aplikasi bank/e-wallet Anda, lalu kirim bukti ke admin melalui WhatsApp.</p>
          <div class="qr-box">
            <img src="/img/qris-demo.svg" alt="Contoh kode QRIS" />
            <span class="hint">QR contoh — kode QRIS aktif dikirim admin melalui WhatsApp.</span>
          </div>
        </div>
      <% } else { %>
        <div class="instruction transfer">
          <h3>Transfer bank</h3>
          <p>Transfer tepat sebesar <strong><%= f.formatRupiah(order.total) %></strong> ke rekening berikut, lalu konfirmasi bukti transfer ke admin.</p>
          <dl class="bank-list">
            <div><dt>Bank</dt><dd>BCA</dd></div>
            <div><dt>Nomor rekening</dt><dd>8830 1122 3344</dd></div>
            <div><dt>Atas nama</dt><dd>PT FieldsOps Nusantara</dd></div>
            <div><dt>Berita transfer</dt><dd><%= order.order_code %></dd></div>
          </dl>
        </div>
      <% } %>

      <div class="instruction-actions">
        <% if (waConfirm) { %>
          <a class="btn btn-wa" href="<%= waConfirm %>" target="_blank" rel="noopener">Konfirmasi via WhatsApp</a>
        <% } %>
        <a class="btn btn-ghost" href="/akun#pesanan">Lihat semua pesanan</a>
      </div>
    </section>

    <section class="card card-pad">
      <div class="panel-head"><h2>Rincian pesanan</h2></div>
      <div class="order-item">
        <img src="<%= order.product_image %>" alt="<%= order.product_name %>" />
        <div class="order-item-body">
          <strong><%= order.product_name %></strong>
          <small><%= order.seller_name %></small>
          <span><%= order.qty %> × <%= f.formatRupiah(order.unit_price) %></span>
        </div>
        <span class="order-item-total"><%= f.formatRupiah(order.unit_price * order.qty) %></span>
      </div>

      <dl class="summary-list">
        <div><dt>Subtotal</dt><dd><%= f.formatRupiah(order.unit_price * order.qty) %></dd></div>
        <div><dt>Ongkos kirim</dt><dd><%= order.shipping_cost === 0 ? 'Gratis' : f.formatRupiah(order.shipping_cost) %></dd></div>
        <% if (order.cod_fee > 0) { %><div><dt>Biaya COD</dt><dd><%= f.formatRupiah(order.cod_fee) %></dd></div><% } %>
      </dl>
      <div class="summary-total">
        <span>Total</span>
        <strong><%= f.formatRupiah(order.total) %></strong>
      </div>

      <div class="address-block">
        <h3>Dikirim ke</h3>
        <p><strong><%= order.customer_name %></strong><br /><%= order.shipping_address %><br /><%= order.city %><%= order.postal_code ? ' ' + order.postal_code : '' %><br /><%= order.customer_phone %></p>
        <% if (order.notes) { %><p class="hint">Catatan: <%= order.notes %></p><% } %>
      </div>
    </section>
  </div>

  <aside class="summary card">
    <div class="summary-head"><h2>Status pesanan</h2></div>
    <p class="status-badge status-<%= statusMeta.tone %>"><%= statusMeta.label %></p>
    <dl class="summary-list">
      <div><dt>Kode</dt><dd><%= order.order_code %></dd></div>
      <div><dt>Metode</dt><dd><%= paymentLabel(order.payment_method) %></dd></div>
      <div><dt>Kanal</dt><dd><%= channelLabel(order.payment_channel) %></dd></div>
      <div><dt>Dibuat</dt><dd><%= f.formatDate(order.created_at) %></dd></div>
    </dl>
    <div class="summary-total">
      <span>Total bayar</span>
      <strong><%= f.formatRupiah(order.total) %></strong>
    </div>
    <a class="btn btn-primary btn-block" href="/">Lanjut belanja</a>
    <p class="summary-note">Butuh bantuan? Hubungi admin dengan menyertakan kode pesanan.</p>
  </aside>
</div>

<%- include('partials/footer') %>
