<%- include('partials/head') %>

<nav class="crumb" aria-label="Breadcrumb">
  <a href="/">Katalog</a>
  <span aria-hidden="true">/</span>
  <a href="/produk/<%= product.id %>"><%= product.name %></a>
  <span aria-hidden="true">/</span>
  <span>Checkout</span>
</nav>

<ol class="checkout-steps" aria-label="Langkah checkout">
  <li class="is-done"><span>1</span>Detail produk</li>
  <li class="is-active"><span>2</span>Data &amp; pembayaran</li>
  <li><span>3</span>Pesanan dibuat</li>
</ol>

<form class="checkout-grid" method="post" action="/checkout" id="checkout-form" novalidate
      data-price="<%= product.price %>"
      data-shipping="<%= totals.shipping %>"
      data-cod-fee="<%= codFee %>"
      data-free-min="2000000">
  <div class="checkout-main">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="product_id" value="<%= product.id %>" />

    <section class="card card-pad">
      <div class="panel-head">
        <h2>Data penerima</h2>
        <span class="hint">Langkah 1 dari 2</span>
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="name">Nama penerima</label>
          <input id="name" name="name" type="text" value="<%= form.name %>" required aria-invalid="<%= errors.name ? 'true' : 'false' %>" />
          <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
        </div>
        <div class="field">
          <label for="phone">Nomor WhatsApp</label>
          <input id="phone" name="phone" type="tel" value="<%= form.phone %>" placeholder="08xxxxxxxxxx" required aria-invalid="<%= errors.phone ? 'true' : 'false' %>" />
          <% if (errors.phone) { %><p class="field-error"><%= errors.phone %></p><% } %>
        </div>
      </div>
    </section>

    <section class="card card-pad">
      <div class="panel-head">
        <h2>Alamat pengiriman</h2>
      </div>
      <div class="form-grid">
        <div class="field span-2">
          <label for="address">Alamat lengkap</label>
          <textarea id="address" name="address" rows="3" placeholder="Jalan, nomor, RT/RW, kelurahan, kecamatan" required aria-invalid="<%= errors.address ? 'true' : 'false' %>"><%= form.address %></textarea>
          <% if (errors.address) { %><p class="field-error"><%= errors.address %></p><% } %>
        </div>
        <div class="field">
          <label for="city">Kota / kabupaten</label>
          <input id="city" name="city" type="text" value="<%= form.city %>" required aria-invalid="<%= errors.city ? 'true' : 'false' %>" />
          <% if (errors.city) { %><p class="field-error"><%= errors.city %></p><% } %>
        </div>
        <div class="field">
          <label for="postal_code">Kode pos <span class="label-hint">(opsional)</span></label>
          <input id="postal_code" name="postal_code" type="text" inputmode="numeric" value="<%= form.postal_code %>" aria-invalid="<%= errors.postal_code ? 'true' : 'false' %>" />
          <% if (errors.postal_code) { %><p class="field-error"><%= errors.postal_code %></p><% } %>
        </div>
        <div class="field span-2">
          <label for="notes">Catatan untuk kurir <span class="label-hint">(opsional)</span></label>
          <textarea id="notes" name="notes" rows="2" maxlength="300" placeholder="Patokan alamat, jam pengiriman, dll."><%= form.notes %></textarea>
        </div>
      </div>
    </section>

    <section class="card card-pad" id="metode-pembayaran">
      <div class="panel-head">
        <h2>Metode pembayaran</h2>
        <span class="hint">Pilih salah satu</span>
      </div>

      <div class="pay-options">
        <% paymentMethods.forEach(function (method) { %>
          <label class="pay-option <%= form.payment_method === method.value ? 'is-selected' : '' %>">
            <input type="radio" name="payment_method" value="<%= method.value %>" <%= form.payment_method === method.value ? 'checked' : '' %> data-pay-method />
            <span class="pay-option-body">
              <span class="pay-option-head">
                <strong><%= method.label %></strong>
                <% if (method.value === 'cod') { %><span class="badge-soft">+<%= f.formatRupiah(15000) %></span><% } %>
                <% if (method.value === 'full') { %><span class="badge-soft">Paling umum</span><% } %>
              </span>
              <span class="pay-option-text"><%= method.description %></span>
            </span>
          </label>
        <% }); %>
      </div>

      <div class="channel-box" data-channel-box <%= form.payment_method === 'full' ? '' : 'hidden' %>>
        <h3>Pilih kanal pembayaran</h3>
        <div class="channel-grid">
          <% paymentChannels.forEach(function (channel) { %>
            <label class="channel-option">
              <input type="radio" name="payment_channel" value="<%= channel.value %>" <%= form.payment_channel === channel.value ? 'checked' : '' %> />
              <span>
                <strong><%= channel.label %></strong>
                <small><%= channel.description %></small>
              </span>
            </label>
          <% }); %>
        </div>
      </div>

      <p class="pay-note">Checkout ini demo: tidak ada pembayaran otomatis. Instruksi transfer/QRIS muncul setelah pesanan dibuat dan admin mengonfirmasi lewat WhatsApp.</p>
    </section>

    <div class="checkout-submit">
      <a class="btn btn-ghost" href="/produk/<%= product.id %>">Kembali ke produk</a>
      <button class="btn btn-primary btn-lg" type="submit">Buat pesanan</button>
    </div>
  </div>

  <aside class="summary card">
    <div class="summary-head">
      <h2>Ringkasan pesanan</h2>
    </div>
    <div class="summary-product">
      <img src="<%= product.image_url %>" alt="<%= product.name %>" />
      <div>
        <strong><%= product.name %></strong>
        <small><%= product.seller_name %> · <%= f.productCode(product.id) %></small>
        <span class="summary-qty">Jumlah: <b data-sum-qty><%= totals.qty %></b> unit</span>
      </div>
    </div>

    <div class="qty-inline">
      <label for="qty-summary">Ubah jumlah</label>
      <div class="qty-stepper small" data-stepper>
        <button type="button" data-qty-step="-1" aria-label="Kurangi jumlah">−</button>
        <input id="qty-summary" name="qty" type="number" value="<%= form.qty %>" min="1" max="<%= maxQty %>" data-qty aria-invalid="<%= errors.qty ? 'true' : 'false' %>" />
        <button type="button" data-qty-step="1" aria-label="Tambah jumlah">+</button>
      </div>
    </div>
    <% if (errors.qty) { %><p class="field-error"><%= errors.qty %></p><% } %>

    <dl class="summary-list">
      <div><dt>Subtotal</dt><dd data-sum-subtotal><%= f.formatRupiah(totals.subtotal) %></dd></div>
      <div><dt>Ongkos kirim</dt><dd data-sum-shipping><%= totals.shipping === 0 ? 'Gratis' : f.formatRupiah(totals.shipping) %></dd></div>
      <div data-cod-row <%= totals.codFee > 0 ? '' : 'hidden' %>><dt>Biaya COD</dt><dd data-sum-cod><%= f.formatRupiah(totals.codFee) %></dd></div>
    </dl>

    <div class="summary-total">
      <span>Total bayar</span>
      <strong data-sum-total><%= f.formatRupiah(totals.total) %></strong>
    </div>

    <p class="summary-note">Gratis ongkir untuk pembelian ≥ <%= f.formatRupiah(2000000) %>. Pesanan diproses admin setelah dikonfirmasi.</p>
  </aside>
</form>

<%- include('partials/footer') %>
