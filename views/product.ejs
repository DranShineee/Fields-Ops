<%- include('partials/head') %>

<nav class="crumb" aria-label="Breadcrumb">
  <a href="/">Katalog</a>
  <span aria-hidden="true">/</span>
  <a href="/?kategori=<%= encodeURIComponent(product.category_name) %>"><%= product.category_name %></a>
  <span aria-hidden="true">/</span>
  <span><%= product.name %></span>
</nav>

<section class="detail-grid">
  <div class="detail-media reveal">
    <img src="<%= product.image_url %>" alt="<%= product.name %>" />
    <% if (product.is_featured) { %><span class="badge-featured">Unggulan</span><% } %>
    <span class="detail-code"><%= f.productCode(product.id) %></span>
  </div>

  <div class="detail-info reveal" style="--delay:80ms">
    <span class="chip"><%= product.category_name %></span>
    <h1><%= product.name %></h1>
    <p class="detail-meta">
      Dijual oleh <strong><%= product.seller_name %></strong>
      <span class="dot-sep">·</span>
      <span class="stock <%= product.stock > 0 ? '' : 'out' %>"><%= f.stockBadge(product.stock).label %></span>
    </p>

    <p class="detail-price"><%= f.formatRupiah(product.price) %></p>
    <p class="detail-desc"><%= product.description || 'Belum ada deskripsi untuk produk ini.' %></p>

    <form class="buy-box" method="get" action="/checkout">
      <input type="hidden" name="produk" value="<%= product.id %>" />
      <div class="buy-row">
        <label class="buy-label" for="qty">Jumlah</label>
        <div class="qty-stepper" data-stepper>
          <button type="button" data-qty-step="-1" aria-label="Kurangi jumlah">−</button>
          <input id="qty" name="qty" type="number" value="1" min="1" max="<%= maxQty %>" data-qty inputmode="numeric" />
          <button type="button" data-qty-step="1" aria-label="Tambah jumlah">+</button>
        </div>
        <span class="qty-hint">Maks. <%= product.stock %> unit</span>
      </div>

      <div class="buy-actions">
        <button class="btn btn-primary btn-lg btn-block" type="submit" <%= product.stock > 0 ? '' : 'disabled' %>>
          Beli sekarang
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </button>
        <% if (product.stock > 0 && waUrl) { %>
          <a class="btn btn-wa-outline btn-lg" href="<%= waUrl %>" target="_blank" rel="noopener">Tanya via WhatsApp</a>
        <% } %>
      </div>
      <p class="hint">Metode pembayaran — bayar penuh (transfer/QRIS) atau COD — dipilih pada langkah checkout.</p>
    </form>

    <ul class="trust-list">
      <li><span aria-hidden="true">✓</span> Stok dan harga mengikuti data seller</li>
      <li><span aria-hidden="true">✓</span> Pesanan diverifikasi admin sebelum dikirim</li>
      <li><span aria-hidden="true">✓</span> Gratis ongkir untuk pembelian ≥ <%= f.formatRupiah(2000000) %></li>
    </ul>
  </div>
</section>

<section class="section detail-extra">
  <div class="info-card reveal">
    <h2>Spesifikasi &amp; informasi</h2>
    <dl class="spec-list">
      <div><dt>Kode produk</dt><dd><%= f.productCode(product.id) %></dd></div>
      <div><dt>Kategori</dt><dd><%= product.category_name %></dd></div>
      <div><dt>Seller</dt><dd><%= product.seller_name %></dd></div>
      <div><dt>Stok tersedia</dt><dd><%= product.stock %> unit</dd></div>
      <div><dt>Harga satuan</dt><dd><%= f.formatRupiah(product.price) %></dd></div>
      <div><dt>Ongkos kirim</dt><dd><%= totals.shipping === 0 ? 'Gratis' : f.formatRupiah(totals.shipping) %></dd></div>
      <div><dt>Pembayaran</dt><dd>Bayar penuh atau COD (+<%= f.formatRupiah(15000) %>)</dd></div>
      <div><dt>Estimasi kirim</dt><dd>2–4 hari kerja</dd></div>
    </dl>
  </div>

  <div class="info-card reveal" style="--delay:80ms">
    <h2>Pilih cara pembayaran</h2>
    <div class="pay-mini-grid">
      <% paymentMethods.forEach(function (method) { %>
        <article class="pay-mini">
          <h3><%= method.label %></h3>
          <p><%= method.tagline %></p>
          <span class="pay-mini-note"><%= method.description %></span>
        </article>
      <% }); %>
    </div>
    <a class="btn btn-outline" href="/checkout?produk=<%= product.id %>&qty=1">Lanjut ke checkout</a>
  </div>
</section>

<% if (related.length > 0) { %>
  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Kategori <%= product.category_name %></span>
        <h2>Produk lain yang relevan</h2>
      </div>
      <a class="btn btn-ghost" href="/?kategori=<%= encodeURIComponent(product.category_name) %>">Lihat semua</a>
    </div>
    <div class="grid">
      <% related.forEach(function (item, index) { %>
        <article class="pcard reveal" style="--delay:<%= index * 60 %>ms">
          <a class="pcard-link" href="/produk/<%= item.id %>" aria-label="Lihat detail <%= item.name %>"></a>
          <div class="media">
            <img src="<%= item.image_url %>" alt="<%= item.name %>" loading="lazy" />
            <% if (item.is_featured) { %><span class="badge-featured">Unggulan</span><% } %>
            <span class="media-cta">Lihat detail
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </span>
          </div>
          <div class="pbody">
            <span class="chip"><%= item.category_name %></span>
            <h3 class="pname"><%= item.name %></h3>
            <div class="row-end">
              <span class="price"><%= f.formatRupiah(item.price) %></span>
              <span class="stock <%= f.stockBadge(item.stock).tone %>"><%= f.stockBadge(item.stock).label %></span>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
