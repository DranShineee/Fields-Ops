<%- include('../partials/head') %>

<div class="view-head">
  <div>
    <h1>Kelola pengguna</h1>
    <p class="muted">Tambah, ubah peran, nonaktifkan, atau hapus akun pengguna.</p>
  </div>
  <a class="btn btn-primary" href="/admin/users/new">Tambah pengguna</a>
</div>

<form class="card toolbar" method="get" action="/admin/users">
  <div class="field grow">
    <label for="q">Cari pengguna</label>
    <input id="q" name="q" type="search" value="<%= filters.q %>" placeholder="Nama, email, atau nomor telepon" />
  </div>
  <div class="field">
    <label for="role">Peran</label>
    <select id="role" name="role">
      <option value="">Semua peran</option>
      <% roles.forEach(function (role) { %>
        <option value="<%= role %>" <%= filters.role === role ? 'selected' : '' %>><%= f.roleLabel(role) %></option>
      <% }); %>
    </select>
  </div>
  <div class="toolbar-actions">
    <button class="btn btn-primary" type="submit">Cari</button>
    <% if (filters.q || filters.role) { %><a class="btn btn-ghost" href="/admin/users">Reset</a><% } %>
  </div>
</form>

<section class="card">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Pengguna</th>
          <th>Peran</th>
          <th>Telepon</th>
          <th>Data</th>
          <th>Status</th>
          <th class="num">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr><td colspan="6" class="table-empty">Tidak ada pengguna yang cocok dengan filter.</td></tr>
        <% } %>
        <% users.forEach(function (user) { %>
          <tr>
            <td>
              <span class="tname"><%= user.name %><%= user.id === currentUser.id ? ' (Anda)' : '' %></span>
              <span class="tsub"><%= user.email %></span>
            </td>
            <td><span class="badge badge-<%= user.role %>"><%= f.roleLabel(user.role) %></span></td>
            <td class="muted"><%= user.phone || '—' %></td>
            <td class="muted">
              <% if (user.role === 'seller') { %>
                <%= user.total_products %> produk · <%= user.total_categories %> kategori
              <% } else { %>—<% } %>
            </td>
            <td>
              <span class="status-dot <%= user.is_active ? 'on' : 'off' %>"><%= user.is_active ? 'Aktif' : 'Nonaktif' %></span>
            </td>
            <td class="actions">
              <a class="btn btn-sm" href="/admin/users/<%= user.id %>/edit">Ubah</a>
              <% if (user.id !== currentUser.id) { %>
                <form method="post" action="/admin/users/<%= user.id %>/toggle" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-sm" type="submit"><%= user.is_active ? 'Nonaktifkan' : 'Aktifkan' %></button>
                </form>
                <form method="post" action="/admin/users/<%= user.id %>/delete" class="inline-form"
                      data-confirm="Hapus <%= user.name %>? Seluruh produk dan kategori milik seller ini juga akan dihapus.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-sm danger" type="submit">Hapus</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<p class="hint table-note">Menampilkan <%= counts.all %> pengguna pada filter aktif. Akun yang dinonaktifkan tidak dapat masuk, namun datanya tetap tersimpan.</p>

<%- include('../partials/footer') %>
