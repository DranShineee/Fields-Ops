<%- include('../partials/head') %>

<div class="view-head">
  <div>
    <span class="eyebrow">Akun</span>
    <h1>Akun saya</h1>
    <p class="section-sub">Kelola data profil, lihat pesanan, dan hubungi admin untuk konfirmasi pembayaran.</p>
  </div>
  <span class="pill"><%= f.roleLabel(currentUser.role) %></span>
</div>

<div class="split">
  <section class="card card-pad">
    <div class="panel-head"><h2>Profil</h2></div>

    <form method="post" action="/akun" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="field">
        <label for="name">Nama</label>
        <input id="name" name="name" type="text" value="<%= form.name %>" required aria-invalid="<%= errors.name ? 'true' : 'false' %>" />
        <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" type="email" value="<%= currentUser.email %>" disabled />
        <p class="hint">Email hanya dapat diubah oleh administrator.</p>
      </div>

      <div class="field">
        <label for="phone">Nomor WhatsApp</label>
        <input id="phone" name="phone" type="tel" value="<%= form.phone %>" placeholder="08xxxxxxxxxx" aria-invalid="<%= errors.phone ? 'true' : 'false' %>" />
        <% if (errors.phone) { %><p class="field-error"><%= errors.phone %></p><% } %>
      </div>

      <div class="field">
        <label for="password">Kata sandi baru <span class="label-hint">(opsional)</span></label>
        <input id="password" name="password" type="password" autocomplete="new-password" aria-invalid="<%= errors.password ? 'true' : 'false' %>" />
        <% if (errors.password) { %><p class="field-error"><%= errors.password %></p><% } else { %><p class="hint">Biarkan kosong jika tidak ingin mengubah kata sandi.</p><% } %>
      </div>

      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Simpan perubahan</button>
      </div>
    </form>
  </section>

  <aside class="card card-pad contact-card">
    <div class="panel-head"><h2>Hubungi admin</h2></div>
    <% if (admin && adminWa) { %>
      <p class="muted">Semua pemesanan dan konfirmasi pembayaran diproses langsung oleh admin.</p>
      <div class="contact-person">
        <span class="avatar lg"><%= admin.name.trim().charAt(0).toUpperCase() %></span>
        <div>
          <strong><%= admin.name %></strong>
          <small><%= f.formatPhone(admin.phone) %></small>
        </div>
      </div>
      <a class="btn btn-wa btn-block" href="<%= adminWa %>" target="_blank" rel="noopener">Chat via WhatsApp</a>
      <% if (summary) { %>
        <dl class="mini-stats">
          <div><dt>Produk aktif</dt><dd><%= summary.products %></dd></div>
          <div><dt>Kategori</dt><dd><%= summary.categories %></dd></div>
        </dl>
      <% } %>
    <% } else { %>
      <p class="muted">Nomor WhatsApp admin belum diatur. Silakan hubungi administrator sistem.</p>
    <% } %>
  </aside>
</div>

<section class="card card-pad" id="pesanan">
  <div class="panel-head">
    <h2>Pesanan saya</h2>
    <a class="btn btn-sm btn-ghost" href="/#produk">Belanja lagi</a>
  </div>

  <% if (orders.length === 0) { %>
    <div class="empty compact">
      <strong>Belum ada pesanan</strong>
      <p class="muted">Pesanan yang Anda buat akan muncul di sini beserta statusnya.</p>
      <a class="btn btn-primary" href="/">Lihat katalog</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Pesanan</th><th>Metode</th><th class="num">Total</th><th>Status</th><th class="num">Aksi</th></tr>
        </thead>
        <tbody>
          <% orders.forEach(function (order) { %>
            <tr>
              <td>
                <div class="product-cell">
                  <img class="thumb" src="<%= order.product_image %>" alt="" />
                  <div>
                    <span class="tname"><%= order.product_name %></span>
                    <span class="tsub"><%= order.order_code %> · <%= order.qty %> unit</span>
                  </div>
                </div>
              </td>
              <td><%= paymentLabel(order.payment_method) %></td>
              <td class="num"><%= f.formatRupiah(order.total) %></td>
              <td>
                <span class="status-badge status-<%= (ORDER_STATUS[order.status] || {}).tone || 'info' %>">
                  <%= (ORDER_STATUS[order.status] || {}).label || order.status %>
                </span>
              </td>
              <td class="actions">
                <a class="btn btn-sm" href="/pesanan/<%= order.order_code %>">Detail</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
