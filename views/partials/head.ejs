<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title ? title + ' — FieldsOps' : 'FieldsOps' %></title>
  <meta name="description" content="FieldsOps — marketplace peralatan, safety, dan layanan lapangan dengan pemesanan langsung via WhatsApp." />
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
<a href="#main" class="skip-link">Langsung ke konten</a>

<div class="topbar">
  <div class="wrap topbar-inner">
    <span><span class="dot"></span>Pengadaan &amp; perawatan peralatan lapangan — Senin s.d. Sabtu, 08.00–17.00 WIB</span>
    <span>Pemesanan langsung melalui <strong>WhatsApp admin</strong></span>
  </div>
</div>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <span class="logo" aria-hidden="true">FO</span>
      <span class="brand-text">
        <strong>FieldsOps</strong>
        <small>Service Marketplace &amp; Management</small>
      </span>
    </a>

    <nav class="nav" aria-label="Navigasi utama">
      <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Katalog</a>

      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/admin" class="nav-link <%= currentPath.startsWith('/admin') && currentPath !== '/admin/users' && currentPath !== '/admin/laporan' ? 'active' : '' %>">Dasbor</a>
        <a href="/admin/users" class="nav-link <%= currentPath.startsWith('/admin/users') ? 'active' : '' %>">Pengguna</a>
        <a href="/admin/laporan" class="nav-link <%= currentPath === '/admin/laporan' ? 'active' : '' %>">Laporan</a>
      <% } else if (currentUser && currentUser.role === 'seller') { %>
        <a href="/seller" class="nav-link <%= currentPath === '/seller' ? 'active' : '' %>">Dasbor</a>
        <a href="/seller/products" class="nav-link <%= currentPath.startsWith('/seller/products') ? 'active' : '' %>">Produk</a>
        <a href="/seller/categories" class="nav-link <%= currentPath.startsWith('/seller/categories') ? 'active' : '' %>">Kategori</a>
      <% } %>

      <% if (currentUser) { %>
        <a href="/akun" class="nav-link <%= currentPath === '/akun' ? 'active' : '' %>">Akun</a>
        <span class="user-chip">
          <span class="avatar" aria-hidden="true"><%= currentUser.name.trim().charAt(0).toUpperCase() %></span>
          <span class="user-meta">
            <strong><%= currentUser.name %></strong>
            <small><%= f.roleLabel(currentUser.role) %></small>
          </span>
        </span>
        <form method="post" action="/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-ghost btn-sm">Keluar</button>
        </form>
      <% } else { %>
        <a href="/login" class="nav-link <%= currentPath === '/login' ? 'active' : '' %>">Masuk</a>
        <a href="/register" class="btn btn-primary btn-sm">Daftar pembeli</a>
      <% } %>
    </nav>
  </div>
</header>

<main id="main" class="wrap page">
  <%- include('flash') %>
