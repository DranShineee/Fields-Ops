<%- include('partials/head') %>

<section class="hero">
  <div class="hero-copy">
    <span class="hero-tag">Katalog resmi</span>
    <h1>Peralatan, safety, dan jasa lapangan dari seller terverifikasi.</h1>
    <p>Cari produk berdasarkan nama atau kategori, lalu selesaikan pemesanan langsung dengan admin melalui WhatsApp. Stok dan harga selalu diperbarui oleh seller.</p>
    <div class="hero-actions">
      <% if (adminWa) { %>
        <a class="btn btn-wa" href="<%= adminWa %>" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.1.81.83-3.03-.2-.31a8.19 8.19 0 0 1-1.26-4.4c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.26.86 5.82 2.42a8.17 8.17 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.25 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.13-.55.12-.16.25-.64.8-.79.96-.14.16-.29.18-.54.06-.25-.12-1.05-.39-2-1.23a7.4 7.4 0 0 1-1.38-1.72c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.41.06-.63.31-.21.25-.82.8-.82 1.96 0 1.16.84 2.27.96 2.43.12.16 1.65 2.52 4.01 3.53.56.24 1 .38 1.34.49.56.18 1.07.15 1.47.09.45-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
          Hubungi admin
        </a>
      <% } %>
      <a class="btn" href="#produk">Lihat katalog</a>
    </div>
  </div>
  <ul class="hero-points">
    <li><strong><%= products.length %></strong> produk siap dipesan</li>
    <li><strong><%= categories.length %></strong> kategori aktif</li>
    <li>Pemesanan tanpa biaya platform</li>
  </ul>
</section>

<form class="card toolbar" method="get" action="/" role="search">
  <div class="field grow">
    <label for="q">Cari produk</label>
    <div class="search-wrap">
      <input id="q" name="q" type="search" value="<%= filters.q %>" placeholder="Contoh: helm safety, multimeter, bor" autocomplete="off" />
    </div>
  </div>
  <div class="field">
    <label for="kategori">Kategori</label>
    <select id="kategori" name="kategori">
      <option value="">Semua kategori</option>
      <% categories.forEach(function (cat) { %>
        <option value="<%= cat.name %>" <%= filters.category === cat.name ? 'selected' : '' %>><%= cat.name %> (<%= cat.total %>)</option>
      <% }); %>
    </select>
  </div>
  <div class="field">
    <label for="sort">Urutkan</label>
    <select id="sort" name="sort">
      <% sortOptions.forEach(function (option) { %>
        <option value="<%= option.value %>" <%= filters.sort === option.value ? 'selected' : '' %>><%= option.label %></option>
      <% }); %>
    </select>
  </div>
  <div class="toolbar-actions">
    <button class="btn btn-primary" type="submit">Terapkan</button>
    <% if (hasFilters) { %><a class="btn btn-ghost" href="/">Reset</a><% } %>
  </div>
</form>

<% if (hasFilters) { %>
  <div class="active-filters">
    <% if (filters.q) { %>
      <a class="filter-chip" href="/?<%= filters.category ? 'kategori=' + encodeURIComponent(filters.category) + '&' : '' %>sort=<%= filters.sort %>">
        Pencarian: “<%= filters.q %>” <span class="filter-chip-x">×</span>
      </a>
    <% } %>
    <% if (filters.category) { %>
      <a class="filter-chip" href="/?<%= filters.q ? 'q=' + encodeURIComponent(filters.q) + '&' : '' %>sort=<%= filters.sort %>">
        Kategori: <%= filters.category %> <span class="filter-chip-x">×</span>
      </a>
    <% } %>
  </div>
<% } %>

<section id="produk">
  <div class="section-head">
    <div>
      <h2>Produk tersedia</h2>
      <p class="muted">Menampilkan <%= products.length %> produk dari seller aktif.</p>
    </div>
    <% if (admin) { %>
      <span class="pill">Admin: <%= admin.name %></span>
    <% } %>
  </div>

  <% if (products.length === 0) { %>
    <div class="card empty">
      <div class="empty-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </div>
      <strong>Produk tidak ditemukan</strong>
      <p class="muted">Coba kata kunci lain atau hapus filter kategori.</p>
      <a class="btn btn-primary" href="/">Lihat semua produk</a>
    </div>
  <% } else { %>
    <div class="grid">
      <% products.forEach(function (p) { %>
        <article class="pcard">
          <div class="media">
            <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy" />
            <% if (p.is_featured) { %><span class="badge-featured">Unggulan</span><% } %>
          </div>
          <div class="pbody">
            <span class="chip"><%= p.category_name %></span>
            <h3 class="pname"><%= p.name %></h3>
            <p class="pdesc"><%= p.description || 'Tanpa deskripsi.' %></p>
            <p class="seller-line">Seller: <strong><%= p.seller_name %></strong> · <%= f.productCode(p.id) %></p>
            <div class="row-end">
              <span class="price"><%= f.formatRupiah(p.price) %></span>
              <span class="stock <%= f.stockBadge(p.stock).tone %>"><%= f.stockBadge(p.stock).label %></span>
            </div>
            <% if (p.stock > 0 && p.waUrl) { %>
              <a class="btn-wa" href="<%= p.waUrl %>" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.1.81.83-3.03-.2-.31a8.19 8.19 0 0 1-1.26-4.4c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.26.86 5.82 2.42a8.17 8.17 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.25 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.13-.55.12-.16.25-.64.8-.79.96-.14.16-.29.18-.54.06-.25-.12-1.05-.39-2-1.23a7.4 7.4 0 0 1-1.38-1.72c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.41.06-.63.31-.21.25-.82.8-.82 1.96 0 1.16.84 2.27.96 2.43.12.16 1.65 2.52 4.01 3.53.56.24 1 .38 1.34.49.56.18 1.07.15 1.47.09.45-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
                Pesan via WhatsApp
              </a>
            <% } else { %>
              <button class="btn-wa disabled" type="button" disabled>Stok habis</button>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
