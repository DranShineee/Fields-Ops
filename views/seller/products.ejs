<%- include('../partials/head') %>

<div class="view-head">
  <div>
    <h1>Produk saya</h1>
    <p class="muted">Kelola produk, stok, harga, dan visibilitas di katalog.</p>
  </div>
  <a class="btn btn-primary" href="/seller/products/new">Tambah produk</a>
</div>

<form class="card toolbar" method="get" action="/seller/products">
  <div class="field grow">
    <label for="q">Cari produk</label>
    <input id="q" name="q" type="search" value="<%= filters.q %>" placeholder="Nama atau deskripsi produk" />
  </div>
  <div class="toolbar-actions">
    <button class="btn btn-primary" type="submit">Cari</button>
    <% if (filters.q) { %><a class="btn btn-ghost" href="/seller/products">Reset</a><% } %>
  </div>
</form>

<section class="card">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Produk</th>
          <th>Kategori</th>
          <th class="num">Harga</th>
          <th class="num">Stok</th>
          <th>Status</th>
          <th class="num">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (products.length === 0) { %>
          <tr><td colspan="6" class="table-empty">Belum ada produk. Klik “Tambah produk” untuk memulai.</td></tr>
        <% } %>
        <% products.forEach(function (product) { %>
          <tr>
            <td>
              <div class="product-cell">
                <img class="thumb" src="<%= product.image_url %>" alt="" />
                <div>
                  <span class="tname"><%= product.name %><%= product.is_featured ? ' ⭐' : '' %></span>
                  <span class="tsub"><%= f.productCode(product.id) %></span>
                </div>
              </div>
            </td>
            <td><span class="chip"><%= product.category_name %></span></td>
            <td class="num"><%= f.formatRupiah(product.price) %></td>
            <td class="num"><span class="stock <%= f.stockBadge(product.stock).tone %>"><%= product.stock %></span></td>
            <td>
              <span class="status-dot <%= product.is_active ? 'on' : 'off' %>"><%= product.is_active ? 'Aktif' : 'Disembunyikan' %></span>
            </td>
            <td class="actions">
              <a class="btn btn-sm" href="/seller/products/<%= product.id %>/edit">Ubah</a>
              <form method="post" action="/seller/products/<%= product.id %>/toggle" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="btn btn-sm" type="submit"><%= product.is_active ? 'Sembunyikan' : 'Tampilkan' %></button>
              </form>
              <form method="post" action="/seller/products/<%= product.id %>/delete" class="inline-form"
                    data-confirm="Hapus produk “<%= product.name %>”? Tindakan ini tidak dapat dibatalkan.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="btn btn-sm danger" type="submit">Hapus</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/footer') %>
