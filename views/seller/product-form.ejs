<%- include('../partials/head') %>

<div class="view-head">
  <div>
    <h1><%= mode === 'create' ? 'Tambah produk' : 'Ubah produk' %></h1>
    <p class="muted">Produk aktif akan langsung tampil di katalog publik.</p>
  </div>
  <a class="btn btn-ghost" href="/seller/products">Kembali</a>
</div>

<% if (categories.length === 0) { %>
  <div class="card card-pad notice-card">
    <div>
      <strong>Kategori belum tersedia</strong>
      <p class="muted">Tambahkan minimal satu kategori sebelum membuat produk.</p>
    </div>
    <a class="btn btn-primary" href="/seller/categories">Kelola kategori</a>
  </div>
<% } %>

<section class="card card-pad form-card">
  <form method="post"
        action="<%= mode === 'create' ? '/seller/products' : '/seller/products/' + product.id %>"
        enctype="multipart/form-data" class="stack" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="form-grid">
      <div class="field span-2">
        <label for="name">Nama produk</label>
        <input id="name" name="name" type="text" value="<%= form.name %>" maxlength="140" required aria-invalid="<%= errors.name ? 'true' : 'false' %>" />
        <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
      </div>

      <div class="field">
        <label for="category_id">Kategori</label>
        <select id="category_id" name="category_id" required aria-invalid="<%= errors.category_id ? 'true' : 'false' %>">
          <option value="">Pilih kategori</option>
          <% categories.forEach(function (category) { %>
            <option value="<%= category.id %>" <%= String(form.category_id) === String(category.id) ? 'selected' : '' %>><%= category.name %></option>
          <% }); %>
        </select>
        <% if (errors.category_id) { %><p class="field-error"><%= errors.category_id %></p><% } %>
      </div>

      <div class="field">
        <label for="price">Harga (Rupiah)</label>
        <input id="price" name="price" type="number" min="0" step="1000" value="<%= form.price %>" required aria-invalid="<%= errors.price ? 'true' : 'false' %>" />
        <% if (errors.price) { %><p class="field-error"><%= errors.price %></p><% } %>
      </div>

      <div class="field">
        <label for="stock">Stok</label>
        <input id="stock" name="stock" type="number" min="0" step="1" value="<%= form.stock %>" required aria-invalid="<%= errors.stock ? 'true' : 'false' %>" />
        <% if (errors.stock) { %><p class="field-error"><%= errors.stock %></p><% } %>
      </div>

      <div class="field span-2">
        <label for="description">Deskripsi</label>
        <textarea id="description" name="description" rows="4" maxlength="500" aria-invalid="<%= errors.description ? 'true' : 'false' %>"><%= form.description || '' %></textarea>
        <% if (errors.description) { %><p class="field-error"><%= errors.description %></p><% } else { %><p class="hint">Maksimal 500 karakter. Jelaskan spesifikasi singkat produk.</p><% } %>
      </div>
    </div>

    <div class="uploader">
      <div class="preview-box <%= form.image_url ? 'has-image' : '' %>" id="preview-box">
        <img id="preview-image" src="<%= form.image_url || '/img/placeholder.svg' %>" alt="Pratinjau gambar produk" <%= form.image_url ? '' : 'hidden' %> />
        <span class="ph" id="preview-placeholder">Tarik gambar ke sini<br />atau pilih berkas</span>
      </div>
      <div class="upload-actions">
        <label class="btn btn-sm file-label" for="image">Pilih gambar</label>
        <input id="image" name="image" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="sr-only" data-image-input />
        <p class="hint">JPG, PNG, WEBP, atau GIF. Maksimal 3 MB.</p>
        <div class="field">
          <label for="image_url">Atau gunakan URL gambar</label>
          <input id="image_url" name="image_url" type="text" value="<%= form.image_url && !form.image_url.startsWith('/uploads/') ? form.image_url : '' %>" placeholder="https://contoh.com/gambar.jpg" aria-invalid="<%= errors.image_url ? 'true' : 'false' %>" />
          <% if (errors.image_url) { %><p class="field-error"><%= errors.image_url %></p><% } %>
        </div>
        <% if (mode === 'edit' && product.image_url) { %>
          <p class="hint">Gambar saat ini: <code><%= product.image_url %></code></p>
        <% } %>
      </div>
    </div>

    <div class="check-row">
      <label class="check">
        <input type="checkbox" name="is_featured" value="1" <%= form.is_featured ? 'checked' : '' %> />
        <span>Tandai sebagai produk unggulan</span>
      </label>
      <label class="check">
        <input type="checkbox" name="is_active" value="1" <%= form.is_active ? 'checked' : '' %> />
        <span>Tampilkan di katalog</span>
      </label>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit"><%= mode === 'create' ? 'Simpan produk' : 'Simpan perubahan' %></button>
      <a class="btn" href="/seller/products">Batal</a>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
