<%- include('../partials/head') %>

<div class="view-head">
  <div>
    <h1>Dasbor seller</h1>
    <p class="muted">Ringkasan inventaris toko <%= currentUser.name %>.</p>
  </div>
  <div class="head-actions">
    <a class="btn" href="/seller/categories">Kelola kategori</a>
    <a class="btn btn-primary" href="/seller/products/new">Tambah produk</a>
  </div>
</div>

<section class="stats">
  <article class="stat">
    <div class="stat-row"><span>Total produk</span><span class="stat-icon">📦</span></div>
    <strong><%= stats.products %></strong>
    <p class="hint"><%= stats.active_products %> tampil di katalog</p>
  </article>
  <article class="stat">
    <div class="stat-row"><span>Total stok</span><span class="stat-icon">📊</span></div>
    <strong><%= stats.stock %></strong>
    <p class="hint"><%= stats.out_of_stock %> produk stok habis</p>
  </article>
  <article class="stat">
    <div class="stat-row"><span>Kategori</span><span class="stat-icon">🏷️</span></div>
    <strong><%= stats.categories %></strong>
    <p class="hint">Kategori milik toko Anda</p>
  </article>
  <article class="stat">
    <div class="stat-row"><span>Unggulan</span><span class="stat-icon">⭐</span></div>
    <strong><%= stats.featured %></strong>
    <p class="hint">Ditampilkan lebih dulu di katalog</p>
  </article>
</section>

<% if (stats.categories === 0) { %>
  <div class="card card-pad notice-card">
    <div>
      <strong>Buat kategori terlebih dahulu</strong>
      <p class="muted">Setiap produk harus memiliki kategori. Tambahkan minimal satu kategori untuk mulai menjual.</p>
    </div>
    <a class="btn btn-primary" href="/seller/categories">Buat kategori</a>
  </div>
<% } %>

<section class="card card-pad">
  <div class="panel-head">
    <h2>Produk terbaru</h2>
    <a class="btn btn-sm" href="/seller/products">Lihat semua</a>
  </div>

  <% if (recentProducts.length === 0) { %>
    <div class="empty compact">
      <strong>Belum ada produk</strong>
      <p class="muted">Tambahkan produk pertama Anda agar tampil di katalog publik.</p>
      <a class="btn btn-primary" href="/seller/products/new">Tambah produk</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Produk</th><th>Kategori</th><th class="num">Harga</th><th class="num">Stok</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% recentProducts.forEach(function (product) { %>
            <tr>
              <td>
                <span class="tname"><%= product.name %></span>
                <span class="tsub"><%= f.productCode(product.id) %></span>
              </td>
              <td><span class="chip"><%= product.category_name %></span></td>
              <td class="num"><%= f.formatRupiah(product.price) %></td>
              <td class="num">
                <span class="stock <%= f.stockBadge(product.stock).tone %>"><%= product.stock %></span>
              </td>
              <td>
                <span class="status-dot <%= product.is_active ? 'on' : 'off' %>"><%= product.is_active ? 'Aktif' : 'Disembunyikan' %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
