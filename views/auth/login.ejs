<%- include('../partials/head') %>

<div class="auth-shell">
  <section class="card auth-card">
    <div class="auth-head">
      <h1>Masuk ke FieldsOps</h1>
      <p class="muted">Kelola katalog, produk, dan pesanan sesuai peran akun Anda.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/login" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="next" value="<%= next %>" />
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= email %>" autocomplete="email" required autofocus />
      </div>
      <div class="field">
        <label for="password">Kata sandi</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <button class="btn btn-primary btn-block" type="submit">Masuk</button>
    </form>

    <p class="auth-foot muted">Belum punya akun? <a href="/register">Daftar sebagai pembeli</a>.</p>
  </section>

  <% if (demoAccounts.length > 0) { %>
    <section class="card demo-card">
      <h2>Akun demo</h2>
      <p class="muted">Gunakan salah satu akun berikut untuk mencoba setiap peran.</p>
      <table class="table compact">
        <thead>
          <tr><th>Peran</th><th>Email</th><th>Kata sandi</th></tr>
        </thead>
        <tbody>
          <% demoAccounts.forEach(function (account) { %>
            <tr>
              <td><%= account.role %></td>
              <td><code><%= account.email %></code></td>
              <td><code><%= account.password %></code></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  <% } %>
</div>

<%- include('../partials/footer') %>
